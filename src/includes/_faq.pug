//- FAQ (shared — homepage + shop)
//- ──────────────────────────────────────────
section#faq.faq
  h2.faq__title(data-i18n='faq.title') FAQ
  .faq__inner
    p.faq__subtitle(data-i18n='faq.subtitle') Everything you need to know before commissioning
    .faq__list
      .faq__item
        h3.faq__question(data-i18n='faq.q1.title') How does a commission work?
        p.faq__answer(data-i18n='faq.q1.answer') Every project starts with a discussion about your vision.

      .faq__item
        h3.faq__question(data-i18n='faq.q2.title') What should I include in a quote request?
        p.faq__answer(data-i18n='faq.q2.answer') Describe miniatures type, painting level, and provide visual references if possible.

      .faq__item
        h3.faq__question(data-i18n='faq.q3.title') How long does a commission take?
        p.faq__answer(data-i18n='faq.q3.answer') Turnaround depends on project size and current workload.

      .faq__item
        h3.faq__question(data-i18n='faq.q4.title') Why do prices vary?
        p.faq__answer(data-i18n='faq.q4.answer') Pricing depends on miniature size, complexity, and finish level.

      .faq__item
        h3.faq__question(data-i18n='faq.q5.title') Do you work with international clients?
        p.faq__answer(data-i18n='faq.q5.answer') Yes, I accept commissions worldwide with careful packaging.

      .faq__item
        h3.faq__question(data-i18n='faq.q6.title') Can you match a specific color scheme?
        p.faq__answer(data-i18n='faq.q6.answer') Yes, with reference images for accuracy and consistency.

      .faq__item
        h3.faq__question(data-i18n='faq.q7.title') Is there a minimum order size?
        p.faq__answer(data-i18n='faq.q7.answer') A minimum of 10 miniatures applies for both painting levels.

      .faq__item
        h3.faq__question(data-i18n='faq.q8.title') Who covers shipping costs?
        p.faq__answer(data-i18n='faq.q8.answer') Clients cover shipping both ways. Miniatures can also be delivered directly to my address.

      .faq__item
        h3.faq__question(data-i18n='faq.q9.title') What happens to leftover model parts?
        p.faq__answer(data-i18n='faq.q9.answer') Leftover parts may be stored and reused for future conversions, unless you request they be returned.
