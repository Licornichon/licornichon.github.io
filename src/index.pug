doctype html
html(lang='fr')
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    meta(name='robots', content='noindex, nofollow')
    title Fool's Cauldron — Bientôt disponible
    link(rel='icon' type='image/x-icon' href='./assets/media/favicon/favicon.ico')
    link(rel='icon' type='image/svg+xml' href='./assets/media/favicon/favicon.svg')
    link(rel='apple-touch-icon' href='./assets/media/favicon/apple-touch-icon.png')
    style.
      @font-face {
        font-family: 'Crusades';
        src: url('./assets/fonts/Crusades.woff2') format('woff2'),
             url('./assets/fonts/Crusades.ttf') format('truetype');
        font-weight: normal;
        font-style: normal;
      }
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        min-height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #0f0f0f;
        color: #e8e8e8;
        font-family: system-ui, -apple-system, sans-serif;
        text-align: center;
        padding: 2rem;
      }
      .brand {
        font-family: 'Crusades', Georgia, serif;
        font-size: clamp(3rem, 12vw, 7rem);
        color: #f4edd1;
        line-height: 1;
        display: block;
        margin-bottom: 2rem;
      }
      .tagline {
        font-size: clamp(0.85rem, 2.5vw, 1rem);
        color: #888;
        letter-spacing: 0.15em;
        text-transform: uppercase;
      }
  body
    div
      span.brand Fool's Cauldron
        br
        | Miniatures
      p.tagline Bientôt disponible
